# انسخي هذا الملف إلى .env وضعي مفاتيحك محليًا. لا ترفعي .env إلى Git.
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
TI_CACHE_HOURS=24
MINI_SIEM_SECRET_KEY=
MINI_SIEM_ADMIN_USERNAME=admin
# أنشئ hash لكلمة المرور باستخدام werkzeug ولا تكتب كلمة المرور هنا.
MINI_SIEM_ADMIN_PASSWORD_HASH=
MINI_SIEM_UPLOAD_RATE_LIMIT=10
FAILED_LOGIN_THRESHOLD=5
MINI_SIEM_DEV_TOOLS=0
MINI_SIEM_COOKIE_SECURE=1
MINI_SIEM_HOSTED_MODE=1
MINI_SIEM_LOCAL_SOURCES=0
